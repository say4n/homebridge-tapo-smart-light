{
  "pluginAlias": "Tapo",
  "pluginType": "platform",
  "singular": true,
  "strictValidation": false,
  "schema": {
    "type": "object",
    "required": [
      "name",
      "email",
      "password"
    ],
    "additionalProperties": false,
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "Tapo"
      },
      "email": {
        "title": "Tapo Email",
        "type": "string",
        "required": true
      },
      "password": {
        "title": "Tapo Password",
        "type": "string",
        "format": "password",
        "required": true
      },
      "transitionDuration": {
        "title": "Transition Duration (ms)",
        "type": "number",
        "default": 200,
        "minimum": 0,
        "maximum": 5000,
        "description": "Duration in milliseconds for gradual on/off and brightness transitions"
      }
    }
  }
}
